# Basis-URL des Edelmetall-Backends für die öffentliche Terminbuchung (api/em).
# Wird zur Build-Zeit eingebacken (Vite). Auf Coolify pro Umgebung als Build-Env
# setzbar; überschreibt die .env.production/.env.development unten.
#
#   Live    → https://app.wertentwickler.de/api/em
#   Staging → https://dev.wertentwickler.de/api/em
#   lokal   → http://127.0.0.1:8000/api/em
VITE_EM_API_BASE="https://app.wertentwickler.de/api/em"

# Registrierungsseite der Edelmetall-Pipeline (Button „Jetzt als Tippgeber registrieren").
#   Live → https://app.wertentwickler.de/edelmetalle/register
#   dev  → https://dev.wertentwickler.de/edelmetalle/register
VITE_EM_REGISTER_URL="https://app.wertentwickler.de/edelmetalle/register"
